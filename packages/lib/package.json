{
    "name": "@oliverperzyk/chest-ui",
    "description": "A easy way to create GUI components that emulate chests in Minecraft: Bedrock Edition.",
    "version": "1.0.0",
    "private": false,
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "homepage": "https://chest-ui.oliverperzyk.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/chest-ui.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/oliverperzyk/chest-ui/issues"
    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "prepare": "bunx husky"
    },
    "lint-staged": {
        "**/*.{json,json5,jsonc,yml,yaml}": [
            "bunx prettier --write --ignore-unknown"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.64.0"
    },
    "dependencies": {
        "@minecraft/server": "^2.8.0",
        "@minecraft/server-ui": "^2.1.0"
    }
}
