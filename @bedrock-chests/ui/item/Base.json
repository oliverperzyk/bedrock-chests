{
   "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
   "namespace": "bedrock-chests-item",
   "item": {
      "type": "panel",
      "size": [
         "18px",
         "18px"
      ],
      "bindings": [
         {
            "binding_type": "collection",
            "binding_collection_name": "form_buttons"
         }
      ],
      "controls": [
         {
            "button@bedrock-chests-item.item_button": {}
         },
         {
            "content@bedrock-chests-item.item_content": {}
         }
      ]
   },
   "button_template": {
      "type": "button",
      "focus_enabled": true,
      "default_control": "default",
      "hover_control": "hover",
      "pressed_control": "pressed",
      "locked_control": "locked",
      "sound_name": "random.click",
      "button_mappings": [
         {
            "from_button_id": "button.menu_select",
            "to_button_id": "#button_id",
            "mapping_type": "pressed"
         },
         {
            "from_button_id": "button.menu_ok",
            "to_button_id": "#button_id",
            "mapping_type": "focused"
         },
         {
            "from_button_id": "bedrock-chests.button_true",
            "to_button_id": "button.form_button_click",
            "mapping_type": "global"
         }
      ],
      "bindings": [
         {
            "binding_type": "view",
            "source_property_name": "('bedrock-chests.button_' + ('%.1s' * #form_button_text = 't'))",
            "target_property_name": "#button_id"
         }
      ],
      "controls": [
         {
            "default": {
               "type": "image",
               "texture": "@bedrock-chests/textures/item/background/default"
            }
         },
         {
            "hover": {
               "type": "image",
               "texture": "@bedrock-chests/textures/item/background/hover",
               "controls": [
                  {
                     "hover_text@bedrock-chests-item.button_hover_text": {}
                  }
               ]
            }
         },
         {
            "pressed": {
               "type": "image",
               "texture": "@bedrock-chests/textures/item/background/default"
            }
         }
      ]
   },
   "button_hover_text": {
      "type": "custom",
      "renderer": "hover_text_renderer",
      "allow_clipping": false,
      // layer must be this high due to scrollbars
      "layer": 30,
      "bindings": [
         {
            "binding_type": "view",
            // removes all tags to show clean text
            "source_property_name": "(#form_button_text - ('%.2s' * #form_button_text))",
            "target_property_name": "#hover_text"
         }
      ]
   },
   "item_content": {
      "type": "panel",
      "controls": [
         {
            "texture_switcher@bedrock-chests-item.item_texture_switcher": {}
         },
         {
            "durability@bedrock-chests-item.item_durability": {}
         },
         {
            "counter@bedrock-chests-item.item_counter": {}
         }
      ]
   },
   "item_texture_switcher": {
      "type": "panel",
      "size": [
         "16px",
         "16px"
      ],
      "controls": [
         {
            "renderer@bedrock-chests-item.item_renderer": {}
         },
         {
            "image@bedrock-chests-item.item_image": {}
         }
      ]
   },
   "item_renderer": {
      "type": "custom",
      "renderer": "inventory_item_renderer",
      "bindings": [
         {
            "binding_type": "collection",
            "binding_collection_name": "form_buttons",
            "binding_name": "#form_button_texture"
         },
         {
            "binding_type": "view",
            "source_property_name": "('%.2s' * #form_button_texture = 'r&')",
            "target_property_name": "#visible"
         },
         {
            "binding_type": "view",
            "source_property_name": "((#form_button_texture - 'r&') * 65536)",
            "target_property_name": "#item_id_aux"
         }
      ]
   },
   "item_image": {
      "type": "image",
      "texture": "#texture",
      "bindings": [
         {
            "binding_type": "collection",
            "binding_collection_name": "form_buttons",
            "binding_name": "#form_button_texture"
         },
         {
            "binding_type": "view",
            "source_property_name": "('%.2s' * #form_button_texture = 'i&')",
            "target_property_name": "#visible"
         },
         {
            "binding_type": "view",
            "source_property_name": "(#form_button_texture - 'i&')",
            "target_property_name": "#texture"
         }
      ]
   },
   "item_durability": {
      "type": "panel",
      "anchor_from": "bottom_middle",
      "anchor_to": "bottom_middle",
      "size": [
         "100%",
         "4px"
      ],
      "offset": [
         "0px",
         "-1px"
      ],
      "controls": [
         {
            "background": {
               "type": "image",
               // Color for black
               "color": [
                  0.00392,
                  0.00392,
                  0.01176
               ],
               "size": [
                  "100%",
                  "100%"
               ]
            }
         },
         {
            "bar": {
               "type": "image",
               "anchor_from": "top_middle",
               "anchor_to": "top_middle",
               "clip_direction": "left",
               "clip_pixelperfect": false,
               // $one variable is used for its decimals - bindings do not accept decimals unless it's a variable
               "$one": 1.0,
               // variable to set the max of the bar, also preserving the decimal point
               "$max": 99.0,
               // Color for green
               "color": [
                  0.06667,
                  0.95294,
                  0.01176
               ],
               "size": [
                  "100%",
                  "2px"
               ],
               "bindings": [
                  {
                     "binding_type": "collection",
                     "binding_collection_name": "form_buttons",
                     "binding_name": "#form_button_text"
                  },
                  {
                     "binding_type": "view",
                     "source_property_name": "('%.4s' * #form_button_text - '%.2s' * #form_button_text)",
                     "target_property_name": "#length"
                  },
                  {
                     "binding_type": "view",
                     "source_property_name": "(($max - #length) / $max)",
                     "target_property_name": "#ratio"
                  },
                  {
                     "binding_type": "view",
                     "source_property_name": "(not (#length = 99))",
                     "target_property_name": "#visible"
                  }
               ]
            }
         }
      ]
   },
   "item_counter": {
      "type": "label",
      "text": "#text",
      "anchor_from": "bottom_right",
      "anchor_to": "bottom_right",
      "size": [
         "default",
         "default"
      ],
      "bindings": [
         {
            "binding_type": "collection",
            "binding_collection_name": "form_buttons",
            "binding_name": "#form_button_text"
         },
         {
            "binding_type": "view",
            "source_property_name": "('%.4s' * #form_button_text - '%.2s' * #form_button_text)",
            "target_property_name": "#count"
         },
         {
            "binding_type": "view",
            "source_property_name": "('§z' + #count)",
            "target_property_name": "#text"
         },
         {
            "binding_type": "view",
            "source_property_name": "(not (#count = 0))",
            "target_property_name": "#visible"
         }
      ]
   }
}