{
    "name": "@chest-ui/api",
    "description": "Small API to synchronize data between the Chest UI library and the Chest UI website.",
    "version": "1.0.0",
    "private": true,
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "homepage": "https://chest-ui.oliverperzyk.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/chest-ui.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/oliverperzyk/chest-ui/issues"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "lint": "bunx eslint .",
        "lint:fix": "bunx eslint --fix .",
        "healthcheck": "bun run ./scripts/docker/HealthCheckDockerScript.ts",
        "build": "bun build --target bun --outdir dist --minify ./src/Main.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.1",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "typescript": "^5",
        "typescript-eslint": "^8.65.0"
    }
}