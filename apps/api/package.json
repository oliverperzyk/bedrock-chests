{
    "name": "@bedrock-chests/api",
    "description": "Small API to synchronize data between the Bedrock Chests library and the Bedrock Chests website.",
    "version": "1.0.0",
    "private": true,
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "homepage": "https://bedrock-chests.oliverperzyk.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/bedrock-chests.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/oliverperzyk/bedrock-chests/issues"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "lint": "bunx eslint .",
        "lint:fix": "bunx eslint --fix .",
        "test": "bun test",
        "test:init": "bun ./tests/TestEnvironment.ts",
        "healthcheck": "bun run ./scripts/docker/HealthCheckDockerScript.ts",
        "build": "bun build --target bun --outdir dist --minify ./src/Main.ts"
    },
    "lint-staged": {
        "**/*.{ts,json,json5,jsonc,md}": [
            "bunx prettier --write --ignore-unknown",
            "bunx eslint --fix"
        ],
        "**/*.{yml,yaml}": [
            "bunx prettier --write --ignore-unknown"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@types/bun": "^1.3.14",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "jiti": "^2.7.0",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "typescript": "^5",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "express": "^5.2.1"
    }
}
