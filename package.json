{
    "name": "@oliverperzyk/chest-ui",
    "description": "The easiest way to create GUI components that emulate chests in Minecraft: Bedrock Edition.",
    "version": "1.0.0",
    "private": true,
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "homepage": "https://chest-ui.oliverperzyk.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/chest-ui.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/oliverperzyk/chest-ui/issues"
    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "lint": "bunx eslint .",
        "lint:fix": "bunx eslint --fix .",
        "prepare": "bunx husky"
    },
    "lint-staged": {
        "**/*.{json,json5,jsonc,md}": [
            "bunx prettier --write --ignore-unknown",
            "bunx eslint --fix"
        ],
        "**/*.{ts,yml,yaml}": [
            "bunx prettier --write --ignore-unknown"
        ]
    },
    "devDependencies": {
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "eslint": "^10.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5"
    }
}
